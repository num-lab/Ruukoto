import assert from "node:assert/strict";
import fs from "node:fs";
import path from "node:path";
import { product } from "./apps/ruukoto-code/src/product.ts";
import { getCodeScheduleRun, type CodeScheduleConfig } from "@ruukoto/core/code-scheduler.ts";
import { getBackgroundProcess } from "@ruukoto/core/background-processes.ts";
import { afterTool, realTools, startTestRuntime, waitFor } from "./test/helpers/testkit.ts";

assert.equal(process.platform, "linux");
let command = "";
let clock = Date.parse("2026-10-26T00:00:00.000Z");
const t = await startTestRuntime("code-scheduled-linux-stop", request => afterTool(request) ? { kind: "text", text: "Linux 后台已启动" } : { kind: "tool_calls", calls: [{ id: "start", name: "process_start", arguments: { command } }] }, { workDirs: 1, config: { ...realTools(), product: product.runtime, scheduler: { now: () => clock, tickMs: 60_000 } } });
try {
  const { session } = await t.runtime.openWorkspace({ cwd: t.work[0], createRequestId: "linux-workspace" });
  const ready = path.join(t.work[0], "scheduled-server.json");
  const source = `const fs=require('node:fs'),http=require('node:http');const server=http.createServer((req,res)=>res.end('SCHEDULED_LINUX_OK'));server.listen(0,'127.0.0.1',()=>{fs.writeFileSync(${JSON.stringify(ready)},JSON.stringify({pid:process.pid,url:'http://127.0.0.1:'+server.address().port}));process.stdout.write('ready\\n');});`;
  const quote = (value: string) => "'" + value.replaceAll("'", "'\\''") + "'";
  command = quote(process.execPath) + " -e " + quote(source);
  const config: CodeScheduleConfig = { title: "Linux 定时后台取消验收", instructions: "启动隔离 HTTP 服务并结束当前轮", workspaceId: session.projectId, permission: "full_access", modelSelection: t.runtime.defaultSelection, rule: { kind: "once", at: new Date(clock + 60_000).toISOString(), timeZone: "UTC", disambiguation: "compatible" } };
  const saved = await t.runtime.saveCodeSchedule({ requestId: "linux-plan", config });
  clock += 60_000;
  await t.runtime.codeScheduler!.scan();
  const run = t.runtime.getCodeSchedule({ planId: saved.plan.id }).runs[0];
  await waitFor("定时根轮完成但后台仍活动", () => t.runtime.store.getTask(run.rootTaskId)!.status === "completed" && fs.existsSync(ready), 30_000);
  const background = t.runtime.listBackgroundProcesses(run.sessionId).processes[0];
  assert.ok(background, JSON.stringify(t.runtime.store.listToolOpsByTask(run.rootTaskId)));
  assert.equal(background.state, "running");
  assert.equal(background.source.kind, "coding-schedule");
  if (background.source.kind === "coding-schedule") assert.equal(background.source.runId, run.id);
  assert.equal(getCodeScheduleRun(t.runtime.store, run.id)!.closedAt, null);
  const info = JSON.parse(fs.readFileSync(ready, "utf8")) as { pid: number; url: string };
  assert.equal(await (await fetch(info.url)).text(), "SCHEDULED_LINUX_OK");
  const canceled = await t.runtime.controlCodeSchedule({ requestId: "linux-cancel", planId: saved.plan.id, expectedVersion: saved.plan.version, control: "cancel" });
  assert.equal(canceled.plan.status, "canceled");
  await waitFor("取消核实后台停止并关闭整项运行", () => getBackgroundProcess(t.runtime.store, background.id)!.stopVerified && getCodeScheduleRun(t.runtime.store, run.id)!.closedAt !== null, 30_000);
  const finalProcess = getBackgroundProcess(t.runtime.store, background.id)!;
  assert.equal(finalProcess.state, "stopped");
  assert.equal(finalProcess.stopVerified, true);
  assert.equal(t.runtime.store.listAllOccupancy().length, 0);
  assert.equal(getCodeScheduleRun(t.runtime.store, run.id)!.status, "canceled");
  await assert.rejects(fetch(info.url));
  assert.ok(fs.existsSync(ready));
  process.stdout.write(JSON.stringify({ platform: "linux", mockModel: true, realProcess: true, rootCompletedWhileBackgroundActive: true, source: finalProcess.source.kind, cancelStoppedProcess: true, stopVerified: finalProcess.stopVerified, occupancyRemaining: t.runtime.store.listAllOccupancy().length, runStatus: getCodeScheduleRun(t.runtime.store, run.id)!.status, retainedWorkspaceResult: fs.existsSync(ready) }) + "\n");
} finally { await t.shutdown(); }
