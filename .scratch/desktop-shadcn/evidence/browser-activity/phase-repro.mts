import assert from 'node:assert/strict';
import { pathToFileURL } from 'node:url';
const root=process.argv[2] ?? process.cwd();
const { Driver }=await import(pathToFileURL(root+'/packages/agent/src/driver.ts').href);
const { ViewState }=await import(pathToFileURL(root+'/packages/view/src/state.ts').href);
const { conversationActivity }=await import(pathToFileURL(root+'/apps/desktop/src/renderer/activity.ts').href);
const at=new Date().toISOString();
const task={id:'phase-task',sessionId:'phase-session',status:'running',input:'阶段重放',createdAt:at,startedAt:at,endedAt:null,cancelRequested:false};
const view=new ViewState(); view.tasks.set(task.id,task);
let seq=0; const recorded=[];
const append=body=>{const event={seq:++seq,taskId:task.id,sessionId:task.sessionId,createdAt:new Date().toISOString(),body};recorded.push(event);view.applyEvent(event,'live');return event};
const driver=Object.create(Driver.prototype);
Object.assign(driver,{currentTask:task,deps:{store:{withTx:fn=>fn(),appendEvent:append}},pendingEntryMsgIds:[],sourceTextBlocks:new Map(),textBlock:null,thinking:null});
const stages=[];
const snapshot=name=>{const activity=conversationActivity(view,task.sessionId,true);stages.push({name,phase:activity.phase,groups:activity.groups.map(group=>group.map(item=>item.kind)),tools:activity.tools.map(item=>item.status)});return activity};
snapshot('running-before-model-request');
driver.beginModelRequest(task); snapshot('provider-request-started');
driver.handleSessionEvent({type:'message_update',message:{role:'assistant'},assistantMessageEvent:{type:'thinking_delta',contentIndex:0,delta:'测试事件里实际记录的 reasoning'}}); snapshot('recorded-reasoning');
driver.handleSessionEvent({type:'message_update',message:{role:'assistant'},assistantMessageEvent:{type:'toolcall_start',contentIndex:1}});
const argumentsStreaming=snapshot('provider-still-streaming-tool-arguments');
append({type:'task.tool_intent',taskId:task.id,toolOpId:'op',sdkCallId:'sdk',toolName:'bash',params:{command:'echo fixture'}}); snapshot('tool-intent-finally-recorded');
append({type:'task.tool_result',taskId:task.id,toolOpId:'op',summary:'fixture',isError:false,artifactIds:[]}); snapshot('between-tool-result-and-next-model-request');
process.stdout.write(JSON.stringify({stages,recordedThinking:recorded.filter(event=>event.body.type==='task.thinking').map(event=>({ended:event.body.endedAt!==null,text:event.body.text}))},null,2)+'\n');
assert.notEqual(argumentsStreaming.phase,null,'工具参数仍在provider中生成时，尾部不应完全消失直到tool_intent到达');
