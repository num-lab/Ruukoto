await (async (page) => { await page.waitForFunction(() => Math.abs(document.querySelector("#right-sidebar").getBoundingClientRect().width - 320) < 1); await page.locator(".app-window").screenshot({path:"output/playwright/ruukoto-pages/nested-pages-dark-narrow.png"}); await page.getByRole("button",{name:"Git 仓库",exact:true}).click(); const before = await (await page.request.get("http://127.0.0.1:63346/_acceptance/metrics")).json(); if (before.calls.filter(x=>x.op==="read_workspace_git").length !== 3) throw new Error("Workspace prefetched"); await page.getByRole("button",{name:"Git graph",exact:true}).click(); await page.getByText("验收提交",{exact:true}).waitFor(); await page.locator(".app-window").screenshot({path:"output/playwright/ruukoto-pages/git-repository-dark.png"}); await page.getByRole("button",{name:"空仓库",exact:true}).click(); const middle = await (await page.request.get("http://127.0.0.1:63346/_acceptance/metrics")).json(); if (middle.calls.filter(x=>x.op==="read_workspace_git").length !== 4) throw new Error("Empty workspace prefetched"); await page.getByRole("button",{name:"Git graph",exact:true}).click(); await page.getByText("暂无提交",{exact:true}).waitFor(); await page.locator(".app-window").screenshot({path:"output/playwright/ruukoto-pages/git-empty-dark.png"}); const after = await (await page.request.get("http://127.0.0.1:63346/_acceptance/metrics")).json(); return {switchingWorkspacesPrefetched:0,gitClicksAddedQueries:after.calls.filter(x=>x.op==="read_workspace_git").length-3,realCommitDisplayed:true,emptyRepositoryDisplayed:true,sidebarWidth:await page.locator("#right-sidebar").evaluate(el=>el.getBoundingClientRect().width),modelCalls:after.modelCalls}; })(page);
