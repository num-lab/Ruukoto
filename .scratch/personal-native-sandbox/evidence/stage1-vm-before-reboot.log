740c7f3a-1a40-4df5-8bd3-7462fb3faf04
[Unit]
Description=Isolated ruukoto native service verification
Requires=user@999.service
After=user@999.service
RequiresMountsFor=/opt/ruukoto/node_modules
[Service]
Type=oneshot
User=ruukoto-native-check
Group=ruukoto-native-check
WorkingDirectory=/opt/ruukoto
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/999
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/999/bus
ExecStart=/usr/local/bin/node --import tsx reboot-worker.mts
KillMode=control-group
TimeoutStopSec=30
[Install]
WantedBy=multi-user.target
State=lingering
Sessions=
Linger=yes
