import assert from 'node:assert/strict';
import * as fs from 'node:fs';
import * as path from 'node:path';
import { createHash } from 'node:crypto';
import { BACKGROUND_CONTEXT } from '@earendil-works/chord/context';
import { openPersonalHarness } from './apps/ruukoto/src/personal-harness.ts';
import { ServiceInspectionEntry } from './apps/ruukoto/src/personal-services.ts';
import { personalProvider, type PersonalModelConfig, type RequestEvidence } from './apps/ruukoto/src/personal-model.ts';
import { PersonalError } from './apps/ruukoto/src/personal-error.ts';
import { MockModelServer } from './test/helpers/mock-provider.ts';

const context = BACKGROUND_CONTEXT;
const unit = 'ruukoto-service-test.service';
const outputDirectory = path.resolve('../evidence');
const profile = path.resolve('../smoke-profile');
const key = 'RUUKOTO_READONLY_SMOKE_PLACEHOLDER_KEY';
const prior = process.env[key];
process.env[key] = 'test-placeholder';
const sha256 = (bytes: Buffer) => createHash('sha256').update(bytes).digest('hex');
const policyHash = () => sha256(fs.readFileSync('/etc/ruukoto/services.json'));
const beforePolicy = policyHash();
let personal: Awaited<ReturnType<typeof openPersonalHarness>> | undefined;
let evidenceNumber = 0;
const server = new MockModelServer((request, index) => {
  if (index === 0) return { kind: 'tool_calls', calls: [{ id: 'live-inspect', name: 'service_inspect', arguments: { unit } }] };
  if (index === 1) {
    evidenceNumber = Number(/原始结果证据：(\d+)/.exec(JSON.stringify(request.messages))?.[1]);
    assert.ok(evidenceNumber > 0, '检查结果须返回可读取证据');
    return { kind: 'tool_calls', calls: [{ id: 'live-read', name: 'read_service_inspection', arguments: { evidence: evidenceNumber } }] };
  }
  assert.equal(index, 2);
  return { kind: 'text', text: '真实只读服务检查结束。' };
});
try {
  const config: PersonalModelConfig = { api: 'openai-completions', baseUrl: await server.start(), modelId: 'mock-model', apiKeyEnv: key, contextWindow: 128000, maxTokens: 1024 };
  const options = { directory: profile, provider: personalProvider(config), modelId: config.modelId, service: { helperPath: '/usr/local/libexec/ruukoto/ruukoto-service', policyPath: '/etc/ruukoto/services.json', sudoPath: '/usr/bin/sudo', useSudo: true } };
  personal = await openPersonalHarness(options);
  assert.equal(await personal.answer('只检查指定测试服务当前状态。', 'readonly-live-smoke'), '真实只读服务检查结束。');
  const entries = (await personal.main.entries({ order: 'ascending' }, 256, undefined, context)).items;
  const captures = entries.filter(ServiceInspectionEntry.is);
  assert.equal(captures.length, 1);
  const capture = captures[0];
  assert.equal(capture.id, evidenceNumber);
  assert.equal(capture.data.code, 'ok');
  assert.equal(capture.data.truncated, false);
  const stdout = Buffer.from(capture.data.stdout, 'base64');
  const stderr = Buffer.from(capture.data.stderr, 'base64');
  assert.match(stdout.toString('utf8'), /LoadState=not-found/);
  const replyLines = stderr.toString('utf8').split('\n').filter(line => line.startsWith('RUUKOTO_SERVICE_REPLY '));
  assert.equal(replyLines.length, 1);
  const reply = JSON.parse(replyLines[0].slice('RUUKOTO_SERVICE_REPLY '.length));
  assert.equal(reply.ok, true);
  assert.equal(reply.verb, 'inspect');
  assert.equal(reply.unit, unit);
  assert.equal(reply.state.id, unit);
  assert.equal(reply.state.loadState, 'not-found');
  assert.equal(reply.policyRevision, beforePolicy);
  const toolResults = entries.flatMap(entry => entry.model ?? []).filter(message => message.role === 'toolResult');
  assert.deepEqual(toolResults.map(message => message.toolName), ['service_inspect', 'read_service_inspection']);
  assert.ok(toolResults.every(message => !message.isError));
  const text = toolResults.map(message => message.content.filter(part => part.type === 'text').map(part => part.text).join(''));
  assert.match(text[0], /LoadState=not-found/);
  const page = JSON.parse(text[1]);
  assert.equal(page.code, 'ok');
  assert.equal(page.text, `stdout:\n${stdout.toString('utf8')}\nstderr:\n${stderr.toString('utf8')}`);
  assert.equal(page.nextOffset, undefined);
  const requests = entries.filter(entry => entry.kind === 'ruukoto.model-request').map(entry => entry.data as RequestEvidence);
  const payloads = requests.filter(request => request.payload !== undefined);
  assert.equal(requests.length, 6);
  assert.equal(server.calls.length, 3);
  assert.deepEqual(payloads.map(request => request.payload), server.calls.map(call => call.raw));
  assert.deepEqual(server.calls[0].tools?.map(tool => (tool.function as { name: string }).name), ['service_inspect', 'read_service_inspection']);
  await personal.close();
  personal = undefined;
  await assert.rejects(openPersonalHarness({ directory: profile, provider: options.provider, modelId: config.modelId }), (error: unknown) => error instanceof PersonalError && error.code === 'service_config_changed');
  personal = await openPersonalHarness(options);
  const restoredEntries = (await personal.main.entries({ order: 'ascending' }, 256, undefined, context)).items;
  assert.deepEqual(restoredEntries.filter(ServiceInspectionEntry.is).map(entry => entry.data), captures.map(entry => entry.data));
  assert.equal(server.calls.length, 3);
  await personal.close();
  personal = undefined;
  assert.equal(policyHash(), beforePolicy);
  fs.writeFileSync(path.join(outputDirectory, 'real-helper.stdout.bin'), stdout);
  fs.writeFileSync(path.join(outputDirectory, 'real-helper.stderr.bin'), stderr);
  fs.writeFileSync(path.join(outputDirectory, 'real-helper-entries.json'), JSON.stringify({ capture, requests }, null, 2) + '\n');
  const summary = { outcome: 'passed', platform: process.platform, node: process.version, unit, state: reply.state, helper: options.service.helperPath, verb: reply.verb, inspectEvidenceCount: captures.length, tools: toolResults.map(message => message.toolName), modelRequests: server.calls.length, recordedRequests: requests.length, stdoutBytes: stdout.length, stderrBytes: stderr.length, stdoutSha256: sha256(stdout), stderrSha256: sha256(stderr), policySha256: beforePolicy, reopenedEvidenceUnchanged: true, missingConfigRefused: true, policyUnchanged: true };
  fs.writeFileSync(path.join(outputDirectory, 'real-helper-summary.json'), JSON.stringify(summary, null, 2) + '\n');
  process.stdout.write(JSON.stringify(summary) + '\n');
} finally {
  await personal?.close();
  await server.close();
  fs.rmSync(profile, { recursive: true, force: true });
  if (prior === undefined) delete process.env[key]; else process.env[key] = prior;
}
