import { mkdtempSync, writeFileSync, rmSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { execFileSync } from "node:child_process";
import { BACKGROUND_CONTEXT } from "@earendil-works/chord/context";
import { openPersonalHarness } from "../../../../apps/ruukoto/src/personal-harness.ts";
import { personalProvider, type PersonalModelConfig } from "../../../../apps/ruukoto/src/personal-model.ts";
import { MockModelServer } from "../../../../test/helpers/mock-provider.ts";
const directory = mkdtempSync(join(tmpdir(), "rk-work-input-"));
const server = new MockModelServer(request => request.system?.includes("你是个人助手的子 Agent") ? { kind: "text", text: "独立分析结果" } : request.messages.at(-1)?.role === "tool" ? { kind: "text", text: "已登记后台分析" } : { kind: "tool_calls", calls: [{ id: "delegate", name: "background_work", arguments: { action: "delegate", content: "分析示例资料", label: "分析员" } }] });
const config: PersonalModelConfig = { api: "openai-completions", baseUrl: await server.start(), modelId: "mock-model", apiKeyEnv: "RUUKOTO_WORK_CAPTURE_KEY", contextWindow: 128000, maxTokens: 1024 };
process.env[config.apiKeyEnv] = "test-only";
const p = await openPersonalHarness({ directory, provider: personalProvider(config), modelId: config.modelId });
await p.answer("请在后台分析示例资料", "owner");
const tasks = await p.harness.commit(tx => tx.scanTasks({ kind: "ruukoto.background-work" }, 16), BACKGROUND_CONTEXT);
for (const task of tasks.items) await p.harness.waitForTask(task.id, BACKGROUND_CONTEXT);
const old = execFileSync("git", ["show", "c1fee03:apps/ruukoto/src/personal-harness.ts"], { encoding: "utf8" });
const oldPrompt = JSON.parse(old.match(/export const PERSONAL_PROMPT = (".*");/)![1]) as string;
const estimate = (value: string) => Math.ceil(Buffer.byteLength(value, "utf8") / 4);
const first = server.calls[0];
const child = server.calls.find(request => request.system?.includes("你是个人助手的子 Agent"))!;
const output = { method: "ceil(UTF-8 bytes / 4)", estimates: { before: { systemPrompt: estimate(oldPrompt), toolSchemas: 0 }, after: { systemPrompt: estimate(first.system!), toolSchemas: estimate(JSON.stringify(first.tools)) }, child: { systemPrompt: estimate(child.system!), toolSchemas: 0 } }, main: { system: first.system, tools: first.tools, toolResults: server.calls.filter(request => !request.system?.includes("你是个人助手的子 Agent")).flatMap(request => request.messages.filter(message => message.role === "tool")) }, child: { system: child.system, tools: child.tools ?? [] } };
writeFileSync(new URL("model-input.json", import.meta.url), JSON.stringify(output, null, 2) + "\n");
process.stdout.write(JSON.stringify(output.estimates) + "\n");
await p.close(); await server.close(); delete process.env[config.apiKeyEnv]; rmSync(directory, { recursive: true, force: true });
