
> ruukoto-workspace@0.1.0 build
> npm run build:native && npm run build:worker && npm run build:script && npm run build --workspaces --if-present


> ruukoto-workspace@0.1.0 build:native
> node scripts/build-native.mjs


> ruukoto-workspace@0.1.0 build:worker
> esbuild packages/agent/src/tool-worker/worker.ts --bundle --format=esm --platform=node --target=node24 --external:@earendil-works/* --outfile=worker/worker.mjs


> ruukoto-workspace@0.1.0 build:script
> node scripts/build-workflow-script.mjs


> ruukoto@0.1.0 build
> mkdir -p ../../dist && npm pack --pack-destination ../../dist

ruukoto-0.1.0.tgz

> ruukoto-code@0.1.0 build
> mkdir -p ../../dist && npm pack --pack-destination ../../dist

ruukoto-code-0.1.0.tgz
