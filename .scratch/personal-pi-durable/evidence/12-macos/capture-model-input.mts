import { mkdtempSync, writeFileSync, readFileSync, rmSync } from "node:fs";
import { BACKGROUND_CONTEXT } from "@earendil-works/chord/context";
import { openPersonalHarness } from "../../../../apps/ruukoto/src/personal-harness.ts";
import { personalProvider, type PersonalModelConfig } from "../../../../apps/ruukoto/src/personal-model.ts";
import { MockModelServer } from "../../../../test/helpers/mock-provider.ts";
import type { PersonalWorkRef } from "../../../../apps/ruukoto/src/personal-work.ts";
const context = BACKGROUND_CONTEXT;
const directory = mkdtempSync("/tmp/rk-note-input-");
let release!: () => void; const wait = new Promise<void>(resolve => { release = resolve; });
let work: PersonalWorkRef;
const server = new MockModelServer(async request => {
  if (request.system?.includes("你是个人助手的子 Agent")) { await wait; return { kind: "text", text: "追加分析结果" }; }
  if (request.messages.at(-1)?.role === "tool") return { kind: "text", text: "已接纳" };
  if (request.messages.at(-1)?.content === "补充当前分析") return { kind: "tool_calls", calls: [{ id: "append", name: "background_work", arguments: { action: "append", work: work.taskId, content: "限定本次分析范围" } }] };
  return { kind: "text", text: "收到" };
});
const config: PersonalModelConfig = { api: "openai-completions", baseUrl: await server.start(), modelId: "mock-model", apiKeyEnv: "RUUKOTO_NOTE_CAPTURE_KEY", contextWindow: 128000, maxTokens: 1024 };
process.env[config.apiKeyEnv] = "test-only";
const p = await openPersonalHarness({ directory, provider: personalProvider(config), modelId: config.modelId });
await p.answer("拥有者分析来源", "owner");
work = await p.work.delegate({ content: "分析资料", requestId: "analysis", sourceRequestId: "owner" });
await p.answer("补充当前分析", "note-owner"); release(); await p.harness.waitForTask(work.taskId, context);
const previous = JSON.parse(readFileSync(new URL("../11-macos/model-input.json", import.meta.url), "utf8"));
const estimate = (text: string) => Math.ceil(Buffer.byteLength(text, "utf8") / 4);
const main = server.calls.find(request => !request.system?.includes("你是个人助手的子 Agent"))!;
const children = server.calls.filter(request => request.system?.includes("你是个人助手的子 Agent"));
const output = { method: "ceil(UTF-8 bytes / 4)", before: previous.estimates.after, after: { systemPrompt: estimate(main.system!), toolSchemas: estimate(JSON.stringify(main.tools)) }, main: { system: main.system, tools: main.tools, toolResults: server.calls.filter(request => !request.system?.includes("你是个人助手的子 Agent")).flatMap(request => request.messages.filter(message => message.role === "tool")) }, child: { system: children[0]!.system, tools: children[0]!.tools ?? [], lastMessages: children.at(-1)!.messages } };
writeFileSync(new URL("model-input.json", import.meta.url), JSON.stringify(output, null, 2) + "\n");
process.stdout.write(JSON.stringify({ before: output.before, after: output.after }) + "\n");
await p.close(); await server.close(); delete process.env[config.apiKeyEnv]; rmSync(directory, { recursive: true, force: true });
