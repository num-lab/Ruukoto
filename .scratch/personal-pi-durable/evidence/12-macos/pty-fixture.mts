import { mkdtempSync, existsSync, watchFile, unwatchFile, writeFileSync, rmSync } from "node:fs";
import { join } from "node:path";
import { BACKGROUND_CONTEXT } from "@earendil-works/chord/context";
import { openPersonalHarness } from "../../../../apps/ruukoto/src/personal-harness.ts";
import { personalProvider, type PersonalModelConfig } from "../../../../apps/ruukoto/src/personal-model.ts";
import { savePersonalConfig } from "../../../../apps/ruukoto/src/personal-config.ts";
import { startPersonalServer, personalControl } from "../../../../apps/ruukoto/src/personal-control.ts";
import { MockModelServer } from "../../../../test/helpers/mock-provider.ts";
const root = mkdtempSync("/tmp/rk-note-pty-"); const directory = join(root, "profile"); const releaseFile = join(root, "release");
let release!: () => void; const wait = new Promise<void>(resolve => { release = resolve; });
const model = new MockModelServer(async request => {
  if (request.system?.includes("你是个人助手的子 Agent") && request.messages.at(-1)?.content === "等待追加的原分析") await wait;
  return { kind: "text", text: request.messages.at(-1)?.content === "只分析今年资料" ? "已按追加要求完成今年资料分析" : "已收到" };
});
const config: PersonalModelConfig = { api: "openai-completions", baseUrl: await model.start(), modelId: "mock-model", apiKeyEnv: "RUUKOTO_NOTE_PTY_KEY", contextWindow: 128000, maxTokens: 1024 };
process.env[config.apiKeyEnv] = "test-only";
const p = await openPersonalHarness({ directory, provider: personalProvider(config), modelId: config.modelId });
await p.answer("分析今年资料", "owner");
const ref = await p.work.delegate({ content: "等待追加的原分析", requestId: "pty", sourceRequestId: "owner", label: "资料分析员" }); await p.close();
savePersonalConfig(directory, config); const server = await startPersonalServer(directory);
watchFile(releaseFile, { interval: 100 }, () => { if (existsSync(releaseFile)) release(); });
writeFileSync(new URL("pty-session.json", import.meta.url), JSON.stringify({ root, directory, releaseFile, work: ref.taskId, pid: process.pid }) + "\n");
process.stdout.write(JSON.stringify({ root, directory, releaseFile }) + "\n");
let stopping = false;
const stop = async () => {
  if (stopping) return; stopping = true; release(); unwatchFile(releaseFile);
  const status = await personalControl(directory, "GET", `/work?work=${ref.taskId}`);
  writeFileSync(new URL("pty-after.json", import.meta.url), JSON.stringify(status, null, 2) + "\n");
  await server.stop(); await model.close(); rmSync(root, { recursive: true, force: true });
};
process.on("SIGTERM", () => { void stop(); }); process.on("SIGINT", () => { void stop(); });
