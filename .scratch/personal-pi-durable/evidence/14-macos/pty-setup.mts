import * as fs from 'node:fs';
import * as path from 'node:path';
import { tmpdir } from 'node:os';
import { BACKGROUND_CONTEXT as c } from '@earendil-works/chord/context';
import { MockModelServer } from '../../../../test/helpers/mock-provider.ts';
import { openPersonalHarness } from '../../../../apps/ruukoto/src/personal-harness.ts';
import { personalProvider } from '../../../../apps/ruukoto/src/personal-model.ts';
import { PersonalDelegationDoc, listPersonalDelegations } from '../../../../apps/ruukoto/src/personal-delegation.ts';
import { startPersonalServer } from '../../../../apps/ruukoto/src/personal-control.ts';
import { savePersonalConfig } from '../../../../apps/ruukoto/src/personal-config.ts';
let group=0;
const model=new MockModelServer(r=>{
 const last=r.messages.at(-1);
 if(r.system?.includes('你是个人助手的子 Agent'))return {kind:'text',text:'后台分析已完成。'};
 if(last?.role==='tool')return {kind:'text',text:String(last.content)};
 if(String(last?.content).startsWith('宿主委托汇总参考'))return {kind:'text',text:'最终报告：隔离分析已完成，完整内容可从原委托查看。'};
 return {kind:'tool_calls',calls:[{id:'call',name:'background_work',arguments:last?.content==='start'?{action:'delegate',content:'隔离委托报告体验',label:'报告体验'}:{action:'report',delegation:group}}]};
});
const directory=fs.mkdtempSync(path.join(process.platform==='darwin'?'/tmp':tmpdir(),'rk14-pty-'));
const config={api:'openai-completions' as const,baseUrl:await model.start(),modelId:'mock-model',apiKeyEnv:'RUUKOTO_PTY_MODEL_KEY',contextWindow:128000,maxTokens:1024};
process.env.RUUKOTO_PTY_MODEL_KEY='test-only';savePersonalConfig(directory,config);
const p=await openPersonalHarness({directory,provider:personalProvider(config),modelId:config.modelId});
await p.answer('start','owner');const ref=(await p.harness.commit(tx=>listPersonalDelegations(tx),c)).items[0].ref;group=ref.entryId;
await p.answer('report','seal');const facts=(await p.harness.snapshot(PersonalDelegationDoc,String(group),c))!.delegation!;await p.harness.waitForTask(facts.report!.taskId,c);await p.close();
const server=await startPersonalServer(directory);process.stdout.write(`PTY_PROFILE=${directory}\n`);
await new Promise<void>(resolve=>process.once('SIGTERM',()=>resolve()));
await server.stop();await model.close();fs.rmSync(directory,{recursive:true,force:true});
