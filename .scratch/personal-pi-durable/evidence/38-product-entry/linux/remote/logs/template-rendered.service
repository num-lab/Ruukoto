[Unit]
Description=ruukoto personal agent backend
Requires=user@1003.service
After=network-online.target user@1003.service

[Service]
Type=simple
# 安装时替换为实际启动账户；完全访问沿用该账户已有的权限。
# Note: 见 .agents/notes/implemented/feature/2026-10-12-full-access-current-account.md
User=eitrous
Group=eitrous
Environment=RUUKOTO_PERSONAL_DIR=/var/lib/ruukoto/personal-durable
Environment=XDG_RUNTIME_DIR=/run/user/1003
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1003/bus
ExecStart="/usr/local/bin/node" /opt/ruukoto/apps/ruukoto/bin/ruukoto.mjs serve
Restart=on-failure
RestartSec=3
# 本设置覆盖后台单元内的进程；原生 user scope 另行核实，重启保留待核实占用。
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
