-/** 找到排除已知任务外的最新 SVC-RESTART 主力（created_at 可能同一毫秒，不能用次序取最后一条）。 */
-async function nextSvcTask(rt: Runtime, exclude: ReadonlySet<string>): Promise<import("@ruukoto/core/types.ts").Task> {
