-  // 修订：导入集合（每行整行规范化哈希 + 文件与凭据 sha256）+ 目标冲突状态
-  const rowDigests = (rows: Row[], idCol = "id") =>
-    rows.map((r) => ({ id: String(r[idCol]), sha: sha256(canonicalJson(r)) })).sort((a, b) => a.id.localeCompare(b.id));
-  const revision = `r1.${sha256(
-    canonicalJson({
-      v: 1,
