-
-  // 会话：角色会话工作目录改写为目标 agent-work；组织映射规则与 21 相同
-  const projectDecisionById = new Map(projectDecisions.map((d) => [d.id, d]));
-  const roleBySession = new Map(set.roles.map((r) => [String(r.session_id), String(r.id)]));
