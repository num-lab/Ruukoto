[Unit]
Description=isolated ruukoto maintenance acceptance
[Service]
Type=simple
User=rktest
Group=rktest
Environment=RK_TEST_KEY=probe-only
ExecStart=/usr/local/bin/node /opt/ruukoto/apps/ruukoto/bin/ruukoto.mjs serve --directory /var/lib/rktest/profile
Restart=no
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=30
SendSIGKILL=no
TimeoutStopFailureMode=terminate
