[Unit]
Description=isolated ruukoto remote acceptance
[Service]
Type=simple
User=rktest
Group=rktest
Environment=NODE_OPTIONS=--import=/opt/ruukoto/systemd-maintenance-hook.mjs
ExecStart=/usr/local/bin/node /opt/ruukoto/apps/ruukoto/bin/ruukoto.mjs remote serve
Restart=no
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=150
SendSIGKILL=no
TimeoutStopFailureMode=terminate
