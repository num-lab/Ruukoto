{
  "name": "@ruukoto/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ruukoto 桌面客户端",
  "main": "out/main/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "desktop:build": "electron-vite build && node scripts/check-build.mjs && electron-builder --mac --arm64 --dir",
    "desktop:mygo": "node scripts/mygo.mjs run",
    "desktop:mygo:build": "node scripts/mygo.mjs build"
  },
  "devDependencies": {
    "@ruukoto/control": "*",
    "@ruukoto/core": "*",
    "@ruukoto/view": "*",
    "@shadcn/react": "0.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "highlight.js": "11.12.0",
    "lucide-react": "1.59.0",
    "node-pty": "^1.1.0",
    "parse5": "8.0.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "dev.ruukoto.desktop",
    "productName": "Ruukoto",
    "directories": {
      "output": "../../dist"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/**/*",
      "!out/mygo/**/*"
    ],
    "npmRebuild": false,
    "asarUnpack": ["**/*.node", "**/spawn-helper"],
    "mac": {
      "identity": "-",
      "category": "public.app-category.developer-tools"
    }
  }
}
