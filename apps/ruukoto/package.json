{
  "name": "ruukoto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*.ts": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "node bin/ruukoto.mjs",
    "dev": "tsx src/dev.ts",
    "build": "mkdir -p ../../dist && npm pack --pack-destination ../../dist"
  },
  "bin": {
    "ruukoto": "bin/ruukoto.mjs"
  },
  "files": [
    "bin",
    "src"
  ],
  "dependencies": {
    "@ruukoto/tui": "*",
    "tsx": "4.23.13"
  },
  "engines": {
    "node": ">=24.15"
  }
}
