[Unit]
Description=ruukoto personal agent backend
Requires=user@@RUN_UID@.service
After=network-online.target user@@RUN_UID@.service

[Service]
Type=simple
# 安装时替换为实际启动账户；完全访问沿用该账户已有的权限。
# Note: 见 .agents/notes/implemented/feature/2026-10-12-full-access-current-account.md
User=@RUN_USER@
Group=@RUN_GROUP@
Environment=RUUKOTO_DATA_DIR=/var/lib/ruukoto/data
Environment=RUUKOTO_AGENT_DIR=/var/lib/ruukoto/agent
Environment=XDG_RUNTIME_DIR=/run/user/@RUN_UID@
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/@RUN_UID@/bus
ExecStart="@NODE_BIN@" /opt/ruukoto/apps/ruukoto/bin/ruukoto.mjs server
Restart=on-failure
RestartSec=3
# 本设置覆盖后台单元内的进程；原生 user scope 另行核实，重启保留待核实占用。
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
