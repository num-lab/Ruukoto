{
  "name": "ruukoto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "ruukoto": "bin/ruukoto.mjs"
  },
  "description": "个人 Agent：后台任务运行时（issue 02）。消息历史以 pi JSONL 会话文件为唯一权威副本，元数据存 node:sqlite。",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "dev": "tsx src/dev.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:model": "RUN_MODEL_CHECK=1 tsx --test test/06-connectivity.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@js-temporal/polyfill": "0.5.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "beautiful-mermaid": "1.1.3",
    "tsx": "4.23.13",
    "typebox": "1.0.12"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3",
    "ws": "8.21.3"
  }
}
