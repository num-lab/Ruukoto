{
  "name": "ruukoto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "ruukoto": "bin/ruukoto.mjs",
    "ruukoto-code": "bin/ruukoto-code.mjs"
  },
  "description": "个人 Agent：后台任务运行时（issue 02）。消息历史以 pi JSONL 会话文件为唯一权威副本，元数据存 node:sqlite。",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "dev": "tsx src/dev.ts",
    "code": "tsx src/code.ts",
    "setup": "node scripts/setup.mjs",
    "build": "esbuild src/agent/tool-worker/worker.ts --bundle --format=esm --platform=node --target=node24 --external:@earendil-works/* --outfile=worker/worker.mjs",
    "build:worker-image": "bash deploy/worker-image/build.sh",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && npm --prefix verification/foundation run typecheck",
    "test": "node scripts/check-environment.mjs && npm run test:app && npm run test:foundation",
    "test:app": "RUN_MODEL_CHECK=0 tsx --test test/*.test.ts",
    "test:foundation": "RUN_MODEL_CHECK=0 npm --prefix verification/foundation test",
    "check:static": "npm run lint && npm run typecheck && npm run verify-notes",
    "verify-notes": "tsx .agents/skills/maintain-notes/scripts/verify-agent-note-tree.ts && tsx .agents/skills/maintain-notes/scripts/verify-agent-note-format.ts && tsx .agents/skills/maintain-notes/scripts/verify-archived-agent-notes.ts",
    "check": "node scripts/check-environment.mjs && npm run build && npm run check:static && npm test",
    "test:docker": "tsx verification/smoke/smoke-04-desktop-execution.mts && tsx verification/smoke/smoke-13-subagent-messaging.mts && tsx verification/smoke/smoke-15-recover-subagents.mts && tsx verification/smoke/smoke-18-im-final-delivery.mts",
    "test:upgrade": "tsx verification/smoke/smoke-24-release-acceptance.mts --upgrade-only",
    "test:release-model": "tsx verification/smoke/smoke-24-release-acceptance.mts",
    "linux:probes": "npm --prefix verification/foundation run linux:probes",
    "test:model": "RUN_MODEL_CHECK=1 tsx --test test/06-connectivity.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@js-temporal/polyfill": "0.5.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "beautiful-mermaid": "1.1.3",
    "esbuild": "0.28.1",
    "tsx": "4.23.13",
    "typebox": "1.0.12"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "@types/ws": "8.18.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "ws": "8.21.3"
  }
}
