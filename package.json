{
  "name": "ruukoto-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "bin": {
    "ruukoto": "apps/ruukoto/bin/ruukoto.mjs",
    "ruukoto-code": "apps/ruukoto-code/bin/ruukoto-code.mjs"
  },
  "description": "个人 Agent 与 Coding Agent 的同仓 workspace。",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "start": "tsx scripts/start.ts",
    "dev": "tsx apps/ruukoto/src/dev.ts",
    "personal:durable": "tsx apps/ruukoto/src/personal-entry.ts",
    "code": "tsx apps/ruukoto-code/src/dev.ts",
    "setup": "node scripts/setup.mjs",
    "build": "npm run build:native && npm run build:worker && npm run build:script && npm run build --workspaces --if-present",
    "build:native": "node scripts/build-native.mjs",
    "build:script": "node scripts/build-workflow-script.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces && npm --prefix verification/foundation run typecheck",
    "test": "node scripts/check-environment.mjs && npm run test:app && npm run test:foundation",
    "test:app": "node scripts/test-app.mjs",
    "test:foundation": "RUN_MODEL_CHECK=0 npm --prefix verification/foundation test",
    "check:static": "npm run lint && npm run typecheck && npm run verify-notes && npm run check:docs",
    "change-scope": "tsx scripts/change-scope.ts",
    "check:docs": "npm run verify-md-links && npm run verify-doc-refs && npm run verify-doc-budgets && npm run verify-md-wrap",
    "verify-md-links": "tsx scripts/verify-md-links.ts",
    "verify-doc-refs": "tsx scripts/verify-doc-refs.ts",
    "verify-doc-budgets": "tsx scripts/verify-doc-budgets.ts",
    "verify-md-wrap": "tsx scripts/verify-md-wrap.ts",
    "verify-notes": "tsx .agents/skills/maintain-notes/scripts/verify-agent-note-tree.ts && tsx .agents/skills/maintain-notes/scripts/verify-agent-note-format.ts && tsx .agents/skills/maintain-notes/scripts/verify-archived-agent-notes.ts",
    "check": "node scripts/check-environment.mjs && npm run build && npm run check:static && npm test",
    "test:upgrade": "tsx verification/smoke/smoke-24-release-acceptance.mts --upgrade-only",
    "test:release-model": "tsx verification/smoke/smoke-24-release-acceptance.mts",
    "linux:probes": "npm --prefix verification/foundation run linux:probes",
    "test:model": "RUN_MODEL_CHECK=1 tsx --test test/06-connectivity.test.ts",
    "build:worker": "esbuild packages/agent/src/tool-worker/worker.ts apps/ruukoto/src/personal-command-worker.ts --bundle --format=esm --platform=node --target=node24 --external:@earendil-works/* --outdir=worker --entry-names=[name] --out-extension:.js=.mjs",
    "test:native": "tsx verification/smoke/smoke-04-desktop-execution.mts && tsx verification/smoke/smoke-13-subagent-messaging.mts && tsx verification/smoke/smoke-15-recover-subagents.mts && tsx verification/smoke/smoke-18-im-final-delivery.mts && tsx verification/smoke/smoke-28-personal-native.mts",
    "desktop:build": "npm run desktop:build --workspace=@ruukoto/desktop"
  },
  "dependencies": {
    "@ruukoto/core": "*",
    "@ruukoto/tui": "*",
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@js-temporal/polyfill": "0.5.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "beautiful-mermaid": "1.1.3",
    "esbuild": "0.28.1",
    "tsx": "4.23.13",
    "typebox": "1.0.12"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "24.13.6",
    "@types/ws": "8.18.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "ws": "8.21.3"
  }
}
